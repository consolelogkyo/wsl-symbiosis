{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WSL Symbiosis",
  "version": "0.1.4",
  "identifier": "com.wslsymbiosis.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WSL Symbiosis",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#050507"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyNUFEOUE4QkRBQjczQzcKUldUSGM2dTlxTmxhZ2pxSEdtaTNHOHNiaGdPR0t2NzE2MHEwS05tVnBqUURkc2tkbHh5YzRkWFYK",
      "endpoints": ["https://github.com/consolelogkyo/wsl-symbiosis/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
